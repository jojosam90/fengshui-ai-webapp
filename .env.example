# AI 大师模型服务
# 直连 Anthropic Claude：只需填 ANTHROPIC_API_KEY（默认模型 claude-opus-5）
# 使用兼容 Anthropic 接口的服务（如小米 MiMo）：再填 ANTHROPIC_BASE_URL 与 AI_MODEL
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
AI_MODEL=

# 登录（一键登录：登录页默认预填以下账号密码）
AUTH_USERNAME=admin
AUTH_PASSWORD=xuanji888
# 会话签名密钥（建议设置为一串随机字符）
AUTH_SECRET=
# 设为 false 则登录页不预填，需要手动输入账号密码
AUTH_PREFILL=true
